{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "CommonJS",
    "moduleResolution": "Node", "ignoreDeprecations": "6.0", "rootDir": "electron",
    "outDir": "dist-electron", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts"]
}
