{
  "name": "cobblemon-friends-launcher",
  "productName": "Cobblemon Launcher",
  "version": "0.3.1",
  "private": true,
  "description": "Launcher privé pour Cobblemon Academy 2.0, entre amis.",
  "author": "Cobblemon entre amis",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/run-electron.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dist": "npm run test && electron-builder --win nsis portable --publish never",
    "publish:modpack": "node scripts/publish-modpack.mjs",
    "publish:launcher": "npm run dist && node scripts/publish-launcher.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "prismarine-nbt": "2.8.0",
    "yauzl": "3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/yauzl": "2.10.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "fr.cobblemon.friends.launcher",
    "productName": "Cobblemon Launcher",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release/0.3.1"
    },
    "files": [
      "dist-electron/**/*",
      "ui/**/*",
      "pack/pack-lock.json",
      "launcher-config.json",
      "package.json",
      "!**/*.map",
      "!**/*.test.*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Cobblemon Launcher",
      "artifactName": "Cobblemon-Launcher-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "portable": {
      "artifactName": "Cobblemon-Launcher-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fraiyee14minecraft-dot",
        "repo": "licaris",
        "releaseType": "release"
      }
    ]
  }
}
